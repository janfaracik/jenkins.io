  :javascript
    document.addEventListener("DOMContentLoaded", () => {
      const marquees = document.querySelectorAll(".logo-marquee");

      marquees.forEach((marquee) => {
        const track = marquee.querySelector(".logo-track");
        if (!track) return;

        // Clone once to create a seamless loop
        const originals = Array.from(track.children);
        originals.forEach((node) => track.appendChild(node.cloneNode(true)));

        let x = 0;
        let singleSetWidth = 0;

        const recalc = () => {
          // After cloning once, total width is ~2x, so half is one set
          const total = track.scrollWidth;
          singleSetWidth = total / 2;
          // Keep x within bounds on resize
          if (singleSetWidth > 0) x = x % singleSetWidth;
        };

        recalc();
        window.addEventListener("resize", recalc);

        const speed = 0.7; // pixels per frame, tweak as you like

        const tick = () => {
          x -= speed;

          // Reset when we've moved one full set
          if (singleSetWidth > 0 && Math.abs(x) >= singleSetWidth) {
            x += singleSetWidth;
          }

          track.style.transform = `translate3d(${x}px, 0, 0)`;
          requestAnimationFrame(tick);
        };

        requestAnimationFrame(tick);
      });
    });

  %div.app-home-section
