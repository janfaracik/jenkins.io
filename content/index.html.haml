  supporters = site.indexpage[:supporters]
  slides = site.indexpage[:carousel]
  latestRelease = site.jenkins.stable

%div.app-home-landing
  .app-container
    %h1
      Build great things at
      %span
        any
      scale.
    %p{:class => 'paulsimon'}
      The leading open source automation server, Jenkins provides thousands of plugins to support building, deploying, and automating any project.
    %div{:class => 'betty'}
      %a{:class => 'app-button app-button--primary', :href => '/download'}
        %ion-icon{:name => "download"}
        Get Jenkins
      %a{:class => 'app-button', :href => '/changelog/' + latestRelease}
        %ion-icon{:name => "sparkles"}
        What's new in Jenkins
        = latestRelease
      %a{:class => 'app-button', :href => '/doc'}
        %ion-icon{:name => "book"}
        Docs

